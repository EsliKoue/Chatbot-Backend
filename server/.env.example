# Groq API Key
# Obtenez votre clé gratuite ici: https://console.groq.com/keys
GROQ_API_KEY=gsk_votre_clé_api_groq_ici

# Modèle Groq (par défaut: llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Port du serveur
PORT=8000
